<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SSHTarpitWatch</RootNamespace>
    <AssemblyName>SSHTarpitWatch</AssemblyName>
    <Version>0.2.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishAot>true</PublishAot>
    <OptimizationPreference>Size</OptimizationPreference>
    <!-- SIGUSR1 自注册需要 [UnmanagedCallersOnly] 取函数指针（设计 §5） -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- 测试缝（设计 §3.5）：internals 可见于 MSTest 测试工程，用于注入假端点/假时钟 -->
  <ItemGroup>
    <InternalsVisibleTo Include="SSHTarpitWatch.Tests" />
  </ItemGroup>

</Project>
