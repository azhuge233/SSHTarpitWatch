{
  "nickname": "home-vps",
  "log_level": "info",
  "server": {
    "port": 2222,
    "bind_family": "auto",
    "delay_ms": 10000,
    "line_length": 32,
    "max_clients": 4096
  },
  "notifications": {
    "telegram": {
      "enabled": true,
      "bot_token": "",
      "chat_id": ""
    },
    "filter": {
      "on_connect": false,
      "on_close": true,
      "min_duration_seconds": 0
    },
    "throttle": {
      "per_ip_seconds": 300,
      "max_per_minute": 3
    }
  }
}
