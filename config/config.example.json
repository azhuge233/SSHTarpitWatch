{
  "nickname": "home-vps",
  "log_level": "info",
  "server": {
    "port": 2222,
    "bind_family": "auto",
    "delay_ms": 10000,
    "line_length": 32,
    "max_clients": 4096
  },
  "notifications": {
    "telegram": {
      // 填好下面两行凭据再启动：enabled=true 且凭据为空会以退出码 1 拒绝启动（避免“静默不通知”）
      "enabled": true,
      "bot_token": "",
      "chat_id": ""
    },
    "filter": {
      "on_connect": false,
      "on_close": true,
      "min_duration_seconds": 0
    },
    "throttle": {
      "per_ip_seconds": 300,
      "max_per_minute": 3
    },
    "geoip": {
      // 库文件放本文件同目录（相对路径以此为基准）；列表顺序即优先级；详见 manual/configuration.md
      "enabled": false,
      "databases": [],
      "language": "zh"
    }
  }
}
